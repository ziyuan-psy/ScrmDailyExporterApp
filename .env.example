# Copy this file to .env and fill values from your currently logged-in browser session.
# Do not commit or share .env.

# Option A: preferred. Paste the Authorization request header value.
SCRM_AUTHORIZATION=Bearer paste_token_here

# Option B: alternatively paste token only. The script will add "Bearer ".
# SCRM_TOKEN=paste_token_here

# Optional but useful when the service also checks cookies.
# SCRM_COOKIE=corpId=ww_your_tenant_id; token=paste_token_here

SCRM_TENANT_ID=ww_your_tenant_id
SCRM_ADMIN_HEADER=1
SCRM_CLIENT_TYPE=pc
SCRM_DEVICE_ID=CODX

# Server-side task-name query. Leave empty to list all tasks for the date first.
TASK_NAME_QUERY=

# Local filters after the date list is fetched.
# Empty INCLUDE_TASK_KEYWORDS means export every non-excluded task.
INCLUDE_TASK_KEYWORDS=
EXCLUDE_TASK_KEYWORDS=测试,海外,境外

# Delivered-customer summary filters.
REACH_EXCLUDE_KEYWORDS=测试,海外,境外
REACH_PAGE_SIZE=100

# Group-send customer-group export filters.
CUSTOMER_GROUP_TASK_NAME_QUERY=
CUSTOMER_GROUP_INCLUDE_KEYWORDS=
CUSTOMER_GROUP_EXCLUDE_KEYWORDS=测试,海外,境外
CUSTOMER_GROUP_OUTPUT_DIR=

# Defaults to 社群任务MMDD when empty.
OUTPUT_DIR=

POLL_INTERVAL_SECONDS=3
POLL_TIMEOUT_SECONDS=600

# SCRM JSON API request retry options.
SCRM_REQUEST_TIMEOUT_SECONDS=60
SCRM_REQUEST_MAX_ATTEMPTS=3
SCRM_REQUEST_RETRY_BASE_DELAY_SECONDS=5
SCRM_BROWSER_FETCH_FALLBACK=1

# Daily catch-up scheduler options.
LOGIN_WAIT_MINUTES=20
CATCHUP_LOOKBACK_DAYS=7
CHROME_DEBUG_PORT=9222
CHAT_ANALYSIS_POLL_TIMEOUT_SECONDS=1800
REACH_DOCX_BACKUP_ENABLED=0
REACH_DOCX_LOCK_WAIT_SECONDS=300
